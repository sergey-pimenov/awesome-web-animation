{
  "name": "web-animation.github.io",
  "version": "1.0.0",
  "description": "List of usefull tools for creating web-animation",
  "main": "index.js",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "prettier": "prettier --write \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint --debug \"src/**/*.{js,jsx}\" --fix",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix"
  },
  "engines": {
    "node": ">=18"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.(js|jsx)": [
      "eslint --fix",
      "git add"
    ],
    "src/**/*.css": [
      "stylelint --fix",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-animation/web-animation.github.io.git"
  },
  "author": "Sergey Pimenov",
  "license": "CC0",
  "bugs": {
    "url": "https://github.com/web-animation/web-animation.github.io/issues"
  },
  "homepage": "https://github.com/web-animation/web-animation.github.io#readme",
  "dependencies": {
    "classnames": "^2.2.6",
    "currency-symbol-map": "^4.0.4",
    "prop-types": "^15.7.2",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "react-fetch-hook": "^1.7.1",
    "react-lines-ellipsis": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.7.4",
    "@playwright/test": "^1.48.2",
    "@rollup/plugin-yaml": "^4.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^9.7.2",
    "babel-eslint": "^10.0.3",
    "eslint": "^6.7.0",
    "eslint-config-airbnb": "^18.0.1",
    "eslint-config-prettier": "^6.7.0",
    "eslint-plugin-babel": "^5.1.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-react": "^7.16.0",
    "eslint-plugin-react-hooks": "^1.7.0",
    "husky": "^3.1.0",
    "lint-staged": "^9.4.3",
    "minireset.css": "0.0.6",
    "postcss": "^8.4.47",
    "postcss-import": "^12.0.1",
    "postcss-mixins": "^6.2.3",
    "postcss-nested": "^4.2.1",
    "prettier": "^1.19.1",
    "stylelint": "^11.1.1",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^19.0.0",
    "stylelint-order": "^3.1.1",
    "stylelint-prettier": "^1.1.1",
    "vite": "^5.4.11"
  }
}
